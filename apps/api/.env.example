# Sustena — environment configuration
#
# Copy to `.env` in this same directory (apps/api/.env) and adjust.
#   cp .env.example .env
#
# The defaults below run the entire stack locally, offline, with ZERO API spend.
# `.env` is gitignored. Never commit real secrets.


# ── AI ────────────────────────────────────────────────────────────────────────
# "mock" activates the local MockClaudeClient: no network calls, no spend.
# The engine never requires a language model — LLMs are an optional node in an
# operative's graph, not a dependency of the core.
ANTHROPIC_API_KEY=mock

CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001
CLAUDE_SONNET_MODEL=claude-sonnet-4-6


# ── Database ──────────────────────────────────────────────────────────────────
# Local SQLite by default. Keep the database OUT of any syncing folder
# (OneDrive, Dropbox, iCloud) — live SQLite files and file sync corrupt
# each other. This has happened in practice.
DATABASE_URL=sqlite+aiosqlite:///./sustena.db


# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION. The application's built-in fallbacks are public
# development values visible in this repository — anything reachable from a
# network MUST override both of these with real, random secrets.
#
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-change-in-production
ADMIN_TOKEN=dev-admin-token


# ── Environment ───────────────────────────────────────────────────────────────
# "development" | "production"
#
# development  → permissive CORS, /docs exposed, developer-only routes mounted.
#                Correct for local work. NOT correct for a public deployment.
# production   → the above are disabled.
ENVIRONMENT=development


# ── Google Cloud (optional) ───────────────────────────────────────────────────
# Only used by the Firestore mirror, which is a no-op stub without credentials.
GOOGLE_CLOUD_PROJECT=sustena-xii


# ── WhatsApp (legacy, inactive) ───────────────────────────────────────────────
# Superseded by the native Android capture path. Left here because the
# configuration is still read at startup; "mock" keeps it entirely offline.
WHATSAPP_TOKEN=mock
WHATSAPP_PHONE_ID=mock
WHATSAPP_VERIFY_TOKEN=change-me
