{
  "id": "biashara",
  "version": "1.0.0",
  "display_name": "Biashara",
  "description": "General Business Sustain — the base sustain for all business forks on Sustena XII. Tracks inventory, double-entry accounts, parties (vendors/customers/staff/investors/owners), orders, purchases, purchase orders, assets, expenses, calendar, and analytics. Vyyb (QSR) and Colosso (Financial Services) extend this spec.",
  "state_schema": {
    "inventory": {
      "type": "object",
      "description": "Inventory ledger. items keyed by item_id; movements is an append-only ledger array.",
      "properties": {
        "items": {
          "type": "object",
          "description": "Dict keyed by item_id. Each value is a stock item record.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "item_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "sku": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "qty": {
                "type": "number",
                "minimum": 0
              },
              "reorder_level": {
                "type": "number",
                "minimum": 0
              },
              "unit_cost": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "item_id",
              "name",
              "qty"
            ]
          }
        },
        "movements": {
          "type": "array",
          "description": "Append-only inventory movement ledger.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "item_id": {
                "type": "string"
              },
              "delta": {
                "type": "number"
              },
              "reason": {
                "type": "string"
              },
              "recorded_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "id",
              "item_id",
              "delta",
              "reason",
              "recorded_at"
            ]
          }
        }
      },
      "required": [
        "items",
        "movements"
      ]
    },
    "accounts": {
      "type": "object",
      "description": "Double-entry accounting. chart is the chart of accounts; journal_entries with nested journal_lines.",
      "properties": {
        "chart": {
          "type": "object",
          "description": "Chart of accounts keyed by account_id.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "account_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "asset",
                  "liability",
                  "equity",
                  "revenue",
                  "expense"
                ]
              },
              "balance": {
                "type": "number"
              }
            },
            "required": [
              "account_id",
              "name",
              "type",
              "balance"
            ]
          }
        },
        "journal_entries": {
          "type": "array",
          "description": "Journal entry headers.",
          "items": {
            "type": "object",
            "properties": {
              "entry_id": {
                "type": "string"
              },
              "date": {
                "type": "string",
                "format": "date-time"
              },
              "description": {
                "type": "string"
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "line_id": {
                      "type": "string"
                    },
                    "account_id": {
                      "type": "string"
                    },
                    "debit": {
                      "type": "number",
                      "minimum": 0
                    },
                    "credit": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "line_id",
                    "account_id",
                    "debit",
                    "credit"
                  ]
                }
              }
            },
            "required": [
              "entry_id",
              "date",
              "lines"
            ]
          }
        },
        "journal_lines": {
          "type": "array",
          "description": "Flat array of all journal lines (denormalised view for fast queries).",
          "items": {
            "type": "object",
            "properties": {
              "line_id": {
                "type": "string"
              },
              "entry_id": {
                "type": "string"
              },
              "account_id": {
                "type": "string"
              },
              "debit": {
                "type": "number",
                "minimum": 0
              },
              "credit": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "line_id",
              "entry_id",
              "account_id",
              "debit",
              "credit"
            ]
          }
        }
      },
      "required": [
        "chart",
        "journal_entries",
        "journal_lines"
      ]
    },
    "parties": {
      "type": "object",
      "description": "Counterparty registry keyed by party_id. Type: vendor | customer | staff | investor | owner.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "party_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "vendor",
              "customer",
              "staff",
              "investor",
              "owner"
            ]
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "party_id",
          "name",
          "type"
        ]
      }
    },
    "orders": {
      "type": "object",
      "properties": {
        "active": {
          "type": "array",
          "description": "Orders in progress.",
          "items": {
            "type": "object"
          }
        },
        "history": {
          "type": "array",
          "description": "Completed or cancelled orders.",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "active",
        "history"
      ]
    },
    "purchases": {
      "type": "object",
      "properties": {
        "active": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "active",
        "history"
      ]
    },
    "purchase_orders": {
      "type": "object",
      "properties": {
        "active": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "active",
        "history"
      ]
    },
    "assets": {
      "type": "object",
      "description": "Fixed asset register keyed by asset_id.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "purchase_cost": {
            "type": "number",
            "minimum": 0
          },
          "book_value": {
            "type": "number",
            "minimum": 0
          },
          "acquired_at": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "asset_id",
          "name",
          "purchase_cost",
          "book_value"
        ]
      }
    },
    "expenses": {
      "type": "array",
      "description": "Business expense records.",
      "items": {
        "type": "object",
        "properties": {
          "expense_id": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "minimum": 0
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "paid_to": {
            "type": "string"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "expense_id",
          "amount",
          "category",
          "recorded_at"
        ]
      }
    },
    "calendar": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "date": {
                "type": "string",
                "format": "date-time"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title",
              "date"
            ]
          }
        }
      },
      "required": [
        "events"
      ]
    },
    "analytics": {
      "type": "object",
      "properties": {
        "period_reports": {
          "type": "array",
          "description": "Periodic P&L / performance snapshots.",
          "items": {
            "type": "object",
            "properties": {
              "period": {
                "type": "string"
              },
              "revenue": {
                "type": "number"
              },
              "cogs": {
                "type": "number"
              },
              "gross_profit": {
                "type": "number"
              },
              "expenses": {
                "type": "number"
              },
              "net_profit": {
                "type": "number"
              },
              "generated_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "period",
              "revenue",
              "net_profit"
            ]
          }
        }
      },
      "required": [
        "period_reports"
      ]
    }
  },
  "operators": [
    {
      "name": "biashara.inventory.restock",
      "description": "Record a stock restock event, increasing item quantity and posting a journal entry (Dr Inventory / Cr Accounts Payable).",
      "params": [
        "item_id",
        "quantity",
        "unit_cost",
        "vendor_id"
      ],
      "pawa_cost": 0
    },
    {
      "name": "biashara.inventory.adjust",
      "description": "Adjust inventory quantity by a delta (positive or negative) with a required reason. Posts a journal entry for the adjustment.",
      "params": [
        "item_id",
        "quantity_delta",
        "reason"
      ],
      "pawa_cost": 0
    },
    {
      "name": "biashara.orders.place",
      "description": "Place a new customer order. Validates item availability and creates an active order record.",
      "params": [
        "items",
        "customer_id",
        "payment_method"
      ],
      "pawa_cost": 0
    },
    {
      "name": "biashara.orders.fulfill",
      "description": "Fulfill an active order: deduct inventory, post revenue journal entries, move order to history.",
      "params": [
        "order_id",
        "outlet_id"
      ],
      "pawa_cost": 0
    },
    {
      "name": "biashara.purchases.record",
      "description": "Record a supplier purchase: update inventory and post Dr Inventory / Cr AP journal entry.",
      "params": [
        "item_id",
        "quantity",
        "unit_cost",
        "vendor_id",
        "invoice_ref"
      ],
      "pawa_cost": 0
    },
    {
      "name": "biashara.po.raise",
      "description": "Raise a Purchase Order to a vendor for items not yet received.",
      "params": [
        "vendor_id",
        "line_items",
        "expected_delivery_date"
      ],
      "pawa_cost": 0
    },
    {
      "name": "biashara.po.receive",
      "description": "Receive goods against an open Purchase Order, updating inventory and AP.",
      "params": [
        "po_id",
        "received_lines"
      ],
      "pawa_cost": 0
    },
    {
      "name": "biashara.accounts.journal_entry",
      "description": "Post a manual double-entry journal entry. Validates that debit total == credit total per entry.",
      "params": [
        "description",
        "lines",
        "date"
      ],
      "pawa_cost": 0
    },
    {
      "name": "biashara.tax.calculate_vat",
      "description": "Calculate VAT on a given amount at the applicable rate and return the breakdown.",
      "params": [
        "amount",
        "vat_rate",
        "inclusive"
      ],
      "pawa_cost": 0
    },
    {
      "name": "biashara.assets.depreciate",
      "description": "Run periodic depreciation on all depreciable assets, posting depreciation journal entries and updating book values.",
      "params": [
        "period",
        "method"
      ],
      "pawa_cost": 0
    },
    {
      "name": "biashara.expenses.record",
      "description": "Record a business expense and post the corresponding journal entry (Dr Expense / Cr Cash or AP).",
      "params": [
        "amount",
        "category",
        "description",
        "paid_to",
        "payment_method"
      ],
      "pawa_cost": 0
    }
  ],
  "operatives": [
    "mentor",
    "navigator",
    "attache",
    "curator"
  ],
  "invariants": [
    {
      "id": "journal_balanced",
      "expression": "ALL accounts.journal_entries[*]: SUM(lines[*].debit) == SUM(lines[*].credit)",
      "description": "Every journal entry must be balanced: total debits must equal total credits. biashara.accounts.journal_entry enforces this before posting."
    },
    {
      "id": "inventory_qty_non_negative",
      "expression": "ALL inventory.items[*].qty >= 0",
      "description": "No inventory item may have a negative quantity. biashara.inventory.adjust enforces this before mutating state."
    }
  ],
  "enforcement": {
    "enabled": true,
    "_note": "Opt-in per Slice 2 rollout discipline. Both invariants compile clean against state_schema (verified — this is the sustain the SUM aggregate extension was built for). Enabled empirically after confirming the full biashara/procurement/vyyb operator test suites pass unchanged with the gate live."
  },
  "ui_schema": {
    "sustain_home": {
      "widget": "sustain_home"
    }
  },
  "access_policy": {
    "owner_ids": "{{owner_ids}}"
  },
  "default_state": {
    "inventory": {
      "items": {},
      "movements": []
    },
    "accounts": {
      "chart": {},
      "journal_entries": [],
      "journal_lines": []
    },
    "parties": {},
    "orders": {
      "active": [],
      "history": []
    },
    "purchases": {
      "active": [],
      "history": []
    },
    "purchase_orders": {
      "active": [],
      "history": []
    },
    "assets": {},
    "expenses": [],
    "calendar": {
      "events": []
    },
    "analytics": {
      "period_reports": []
    }
  },
  "parameters": [
    {
      "name": "owner_ids",
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of user IDs with owner (Level 0) access. At least one required at instantiation.",
      "required": true
    },
    {
      "name": "business_name",
      "type": "string",
      "description": "Display name for this business sustain instance.",
      "required": true
    },
    {
      "name": "currency",
      "type": "string",
      "description": "ISO 4217 currency code for all monetary values in this sustain.",
      "required": false,
      "default": "KES"
    }
  ],
  "_notes": {
    "epic": "Epic 1.5.1 — Biashara base sustain spec.",
    "forks": "vyyb.json (QSR) and colosso.json (Financial Services) extend this spec via extends: biashara.",
    "accounting": "Double-entry enforced by journal_balanced invariant. All monetary operators must post balanced journal entries.",
    "migration": "sustena/scripts/migrate_vyyb.py seeds a Vyyb instance from the legacy Vyyb OS SQLite database."
  }
}