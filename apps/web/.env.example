# Sustena XII — frontend environment
# Copy to .env.local and fill in your values.

# Backend URL. Leave blank (or omit entirely) to use Vite's dev proxy,
# which forwards /api, /devui, /orchie, /seed → http://localhost:9000.
# Set this only if you need to override the backend address explicitly,
# e.g. for a deployed environment: VITE_API_BASE=https://api.sustena.io
# VITE_API_BASE=

# No admin token here — the app authenticates with a real per-user session
# (email + password, via the login screen), stored client-side after login.
# There is nothing to configure for auth; register or log in on first load.
