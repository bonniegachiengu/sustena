# Sustena XII — Environment Variables
# Copy this file to .env — all defaults below work out of the box for local dev.
# "mock" values activate stubs: no external services, no credentials, no spend.
# Replace with real values when you're ready to go live.

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── AI — MockClaudeClient active when set to "mock" ──────────────────────────
# Replace with sk-ant-... when ready for real M-Pesa parsing
ANTHROPIC_API_KEY=mock
CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001
CLAUDE_SONNET_MODEL=claude-sonnet-4-6

# ── Database — SQLite, local file, no setup needed ───────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./sustena.db

# ── WhatsApp — MockWhatsAppSender active when set to "mock" ──────────────────
# Messages print to console + whatsapp_mock_outbox.jsonl
# Replace with real Meta credentials when ready
WHATSAPP_TOKEN=mock
WHATSAPP_PHONE_ID=mock
WHATSAPP_VERIFY_TOKEN=sustena_webhook_verify_2026

# ── Security — fine for local dev, change before any real users ──────────────
SECRET_KEY=dev-secret-change-in-production
ADMIN_TOKEN=dev-admin-token

# ── Google Cloud — MockFirestoreSync active in development ───────────────────
# No credentials needed locally. Set up GCP project when ready to deploy.
GOOGLE_CLOUD_PROJECT=sustena-xii
