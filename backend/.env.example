# Sustena XII — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ── AI ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Database ──────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./sustena.db

# ── WhatsApp Business API ─────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=sustena_webhook_verify_2026

# ── Security ──────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_TOKEN=change-me-to-another-random-string

# ── Environment ───────────────────────────────────
# Options: development | production
ENVIRONMENT=development

# ── Claude models ─────────────────────────────────
CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001
CLAUDE_SONNET_MODEL=claude-sonnet-4-6

# ── Google Cloud (for Firestore sync) ─────────────
# Set GOOGLE_APPLICATION_CREDENTIALS to path of your service account JSON
# OR deploy to Cloud Run where the service account is attached automatically
GOOGLE_CLOUD_PROJECT=sustena-xii
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
